# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# Contact form delivery (Resend). Without RESEND_API_KEY the form reports itself offline
# and points visitors to the email address instead.
RESEND_API_KEY=
# Where contact messages are delivered.
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend.
CONTACT_FROM_EMAIL="Portfolio <contact@tabishjeelani.com>"

# Optional privacy-first page analytics (Plausible or self-hosted Plausible/Umami).
# Leave NEXT_PUBLIC_PLAUSIBLE_SRC empty to ship without it.
NEXT_PUBLIC_PLAUSIBLE_SRC=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tabishjeelani.com
