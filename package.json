{
  "name": "tenebris-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "tabishjeelani.com — portfolio built on the Tenebris design system.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "prepare:assets": "node scripts/build-tokens.mjs && node scripts/copy-gpu-benchmarks.mjs && node scripts/build-portrait.mjs",
    "dev": "pnpm run prepare:assets && next dev",
    "build": "pnpm run prepare:assets && next build",
    "start": "next start",
    "tokens": "node scripts/build-tokens.mjs",
    "portrait": "node scripts/build-portrait.mjs",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-email/render": "^2.3.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "detect-gpu": "^5.0.70",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.75.0",
    "next": "15.5.29",
    "postprocessing": "^6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.38.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.29",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
